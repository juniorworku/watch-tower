FROM python:3.12-slim
WORKDIR /app
COPY requirements.lock /app/backend/requirements.lock
RUN pip install --no-cache-dir -r backend/requirements.lock
COPY . /app/backend
ENV WATCHTOWER_ENV_FILES=0 COOKIE_SECURE=1 WATCHTOWER_SEED_FROM_SNAPSHOT=0
EXPOSE 80
CMD ["sh", "-c", ": \"${DATABASE_URL:?Set a managed PostgreSQL DATABASE_URL in Vercel}\"; exec python -m uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT:-80} --proxy-headers"]
