# Backend-only settings. Copy to backend/.env; do not commit real secrets.
# Prefer a scrypt hash generated with: python -m backend.app.cli hash-password /tmp/hash.txt
DASHBOARD_PASSWORD=change-me
# If setting a scrypt hash, single-quote the whole value (important for Compose).
DASHBOARD_PASSWORD_HASH=
WATCHTOWER_API_KEY=
CRON_SECRET=
WATCHTOWER_DATABASE=backend/data/watchtower.sqlite3
# PostgreSQL takes precedence over the legacy SQLite path when set.
# Docker setup generates DATABASE_URL in backend/.env.docker.
DATABASE_URL=
# Set 0 when importing existing state before first startup.
WATCHTOWER_SEED_FROM_SNAPSHOT=1
PUBLIC_APP_URL=http://localhost:3000
COOKIE_SECURE=0

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_VAULT_FOLDER_ID=
GOOGLE_CALENDAR_ID=primary
NOTION_TOKEN=
NOTION_READING_LOG_ID=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Optional messaging channels. Reference these names in Agent > Connect.
# Use a separate BOT_ prefix per agent; values stay in the backend environment.
BOT_RESEARCH_TOKEN=
BOT_RESEARCH_SECRET=
# WhatsApp only: arbitrary webhook verification token, distinct from Meta app secret.
BOT_RESEARCH_VERIFY_TOKEN=
