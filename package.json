{
  "name": "watchtower",
  "private": true,
  "workspaces": [
    "frontend",
    "tools"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "test": "npm run test --workspace frontend",
    "test:backend": "python3 -m pytest backend/tests",
    "dev:backend": "python3 -m uvicorn backend.app.main:app --reload --port 8000",
    "snapshot": "node backend/scripts/snapshot-vault.mjs",
    "automation": "node backend/runtime/run-automation.mjs",
    "deploy:vercel": ".venv/bin/python tools/deploy_vercel.py"
  }
}
