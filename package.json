    "automation": "node scripts/run-automation.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "marked": "^18.1.1",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.17.5",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
