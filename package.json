{
  "name": "watchtower-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "snapshot": "node scripts/snapshot-vault.mjs",
    "dev": "npm run snapshot && next dev",
    "prebuild": "node scripts/snapshot-vault.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
